<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="railway_rover">

  <!-- ==================== Materials ==================== -->
  <material name="chassis_color">
    <color rgba="0.2 0.25 0.3 1.0"/>
  </material>

  <material name="wheel_color">
    <color rgba="0.6 0.6 0.65 1.0"/>
  </material>

  <material name="camera_color">
    <color rgba="0.1 0.7 0.3 1.0"/>
  </material>

  <material name="mount_color">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- ==================== Base Footprint ==================== -->
  <link name="base_footprint"/>

  <!-- ==================== Base Link (Chassis) ==================== -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0468" ixy="0.0" ixz="0.0" iyy="0.0760" iyz="0.0" izz="0.1041"/>
    </inertial>
  </link>

  <!-- ==================== Wheel Macro ==================== -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * 0.14} ${y_reflect * 0.17} -0.02" rpy="-1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.04"/>
        </geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.00086" ixy="0.0" ixz="0.0" iyy="0.00086" iyz="0.0" izz="0.0016"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Instantiate 4 Wheels -->
  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- ==================== Camera Mount & Link ==================== -->
  <!-- Camera Mount Link (fixed to front-center top of chassis) -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.18 0.0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="mount_color"/>
    </visual>
  </link>

  <!-- Camera Module Joint: Angled at 50 degrees relative to ground (0.872665 rad pitch downward) -->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <!-- Pitch angle: 50 deg downward = 0.872665 rad pitch -->
    <origin xyz="0.02 0.0 0.04" rpy="0 0.872665 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.03"/>
      </geometry>
      <material name="camera_color"/>
    </visual>
  </link>

  <!-- ROS Camera Optical Frame standard (X-Right, Y-Down, Z-Forward optical axis) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_optical_frame"/>

</robot>
